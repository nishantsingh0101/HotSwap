# Hot Swap settings. Copy to .env (hotswap init does this for you).

# Local Switch server started by `hotswap switch up`
HOTSWAP_SWITCH_URL=http://127.0.0.1:18000
HOTSWAP_MATTERMOST_URL=http://127.0.0.1:18065
HOTSWAP_ROOM=hotswap-demo

# Console and gateway
HOTSWAP_GATEWAY_PORT=7600

# Which provider runs each role: replay, claude-code, codex, opencode, openai
# replay applies recorded steps, so runs are repeatable without any account.
HOTSWAP_BUILDER_PROVIDER=replay
HOTSWAP_STANDBY_PROVIDER=replay
HOTSWAP_VERIFIER_PROVIDER=replay
# Optional: model names and vendor labels (the vendor rule compares labels)
# HOTSWAP_BUILDER_PROVIDER=claude-code
# HOTSWAP_STANDBY_PROVIDER=codex
# HOTSWAP_VERIFIER_PROVIDER=openai
# HOTSWAP_VERIFIER_VENDOR=google
# HOTSWAP_VERIFIER_MODEL=gemini-2.5-flash

# Any OpenAI-compatible API (OpenAI, Gemini, Groq, OpenRouter, ...)
HOTSWAP_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
HOTSWAP_OPENAI_API_KEY=

# Where the code lives: local (a guarded bare repository) or github
HOTSWAP_REMOTE=local
# HOTSWAP_GITHUB_REPO=your-name/ledgerlite
# GITHUB_TOKEN=

# Failure detection
HOTSWAP_DEAD_SECONDS=6
HOTSWAP_STALL_SECONDS=25
HOTSWAP_DRAIN_SECONDS=5
